<% 
  const currentPage = 'discounts';
  const title = 'Promotions - POS System';

  // Helper for relative time
  function getRelativeTime(date) {
    const now = new Date();
    const diffTime = date - now;
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    
    if (diffDays < 0) return { text: `Expired ${Math.abs(diffDays)}d ago`, color: 'text-red-500', icon: 'fa-history' };
    if (diffDays === 0) return { text: 'Expires today', color: 'text-amber-500', icon: 'fa-hourglass-half' };
    if (diffDays < 7) return { text: `In ${diffDays} days`, color: 'text-amber-500', icon: 'fa-clock' };
    return { text: `In ${diffDays} days`, color: 'text-emerald-500', icon: 'fa-calendar-alt' };
  }
%>
<%- include('../../layouts/header', { user, currentPage, title }) %>

<!-- Header and Summary Stats -->
<div class="mb-8 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
  <div>
    <h1 class="text-3xl font-black text-gray-900 tracking-tight">Promotions & Discounts</h1>
    <p class="text-gray-500 font-medium mt-1">Manage marketing codes and special offers.</p>
  </div>
  <a href="/discounts/add" class="btn bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-200 px-6 py-3 transition-all transform hover:-translate-y-1 rounded-xl">
    <i class="fas fa-plus mr-2"></i> Create Discount
  </a>
</div>

<!-- Stats Dashboard -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
  <div class="card p-4 bg-white border border-gray-100 flex items-center gap-4">
    <div class="w-10 h-10 rounded-xl bg-gray-50 text-gray-400 flex items-center justify-center"><i class="fas fa-tags"></i></div>
    <div>
      <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Total Codes</p>
      <p class="text-lg font-black text-gray-900"><%= stats.total %></p>
    </div>
  </div>
  <div class="card p-4 bg-white border border-gray-100 flex items-center gap-4">
    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center"><i class="fas fa-check-circle"></i></div>
    <div>
      <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Active</p>
      <p class="text-lg font-black text-emerald-600"><%= stats.active %></p>
    </div>
  </div>
  <div class="card p-4 bg-white border border-gray-100 flex items-center gap-4">
    <div class="w-10 h-10 rounded-xl bg-red-50 text-red-600 flex items-center justify-center"><i class="fas fa-times-circle"></i></div>
    <div>
      <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Expired</p>
      <p class="text-lg font-black text-red-600"><%= stats.expired %></p>
    </div>
  </div>
  <div class="card p-4 bg-white border border-gray-100 flex items-center gap-4">
    <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center"><i class="fas fa-toggle-off"></i></div>
    <div>
      <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Disabled</p>
      <p class="text-lg font-black text-indigo-600"><%= stats.inactive %></p>
    </div>
  </div>
</div>

<!-- Filters and Search -->
<div class="card mb-8 p-6 bg-white border border-gray-100 shadow-sm rounded-2xl">
  <form method="GET" action="/discounts" id="filterForm" class="flex flex-col md:flex-row gap-4">
    <div class="flex-1 relative">
      <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
      <input 
        type="text" 
        name="search" 
        placeholder="Search by code..." 
        class="form-control pl-12 pr-10 py-3 search-field focus:ring-4 focus:ring-indigo-50"
        value="<%= search %>"
        autocomplete="off"
      >
    </div>
    <div class="w-full md:w-48">
      <select name="filter" class="form-control py-3 font-semibold text-gray-700 cursor-pointer" onchange="this.form.submit()">
        <option value="">Status: All</option>
        <option value="active" <%= filter === 'active' ? 'selected' : '' %>>Active</option>
        <option value="expired" <%= filter === 'expired' ? 'selected' : '' %>>Expired</option>
        <option value="disabled" <%= filter === 'disabled' ? 'selected' : '' %>>Disabled</option>
      </select>
    </div>
    <div class="w-full md:w-48">
      <select name="sort" class="form-control py-3 font-semibold text-gray-700 cursor-pointer" onchange="this.form.submit()">
        <option value="">Sort: Newest</option>
        <option value="expiry-soon" <%= sort === 'expiry-soon' ? 'selected' : '' %>>Expiry: Soonest</option>
        <option value="value-desc" <%= sort === 'value-desc' ? 'selected' : '' %>>Value: Highest</option>
        <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Date: Oldest</option>
      </select>
    </div>
  </form>
</div>

<!-- Discounts Table -->
<div class="card overflow-hidden p-0 border-none shadow-xl bg-white rounded-2xl">
  <!-- Desktop View -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest">Promotion Code</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest text-center">Value</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest text-center">Benefit</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest">Expiry Window</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest text-center">Status</th>
          <th class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% discounts.forEach(discount => { 
           const relTime = getRelativeTime(discount.expiryDate);
        %>
          <tr class="product-row group transition-all hover:bg-indigo-50/30 <%= discount.status === 'expired' ? 'opacity-70 bg-gray-50/30' : '' %>" onclick="location.href='/discounts/edit/<%= discount._id %>'">
            <td class="px-8 py-6">
              <div class="flex items-center gap-2">
                <span class="code-badge uppercase group-hover:bg-indigo-600 group-hover:text-white group-hover:border-indigo-600 transition-all">
                  <%= discount.code %>
                </span>
                <i class="fas fa-copy copy-btn" onclick="copyCode('<%= discount.code %>', event)" title="Copy Code"></i>
              </div>
            </td>
            <td class="px-6 py-6 text-center">
              <span class="text-xl font-black text-gray-900 tracking-tighter">
                <%= discount.value %><%= discount.type === 'percentage' ? '%' : '' %>
              </span>
            </td>
            <td class="px-6 py-6 text-center">
               <span class="px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-widest <%= discount.type === 'percentage' ? 'bg-blue-50 text-blue-600' : 'bg-emerald-50 text-emerald-600' %>">
                 <%= discount.type === 'percentage' ? 'Percent OFF' : 'Fixed Amount' %>
               </span>
            </td>
            <td class="px-6 py-6">
              <div class="flex flex-col">
                <p class="text-xs font-black text-gray-800 flex items-center gap-1.5">
                   <i class="fas <%= relTime.icon %> <%= relTime.color %> text-[10px]"></i>
                   <%= discount.expiryDate.toLocaleDateString('en-PK', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                </p>
                <span class="<%= relTime.color %> text-[10px] font-bold mt-1 uppercase tracking-tighter italic">
                   <%= relTime.text %>
                </span>
              </div>
            </td>
            <td class="px-6 py-6 text-center">
              <% if (discount.status === 'active' && discount.expiryDate >= new Date()) { %>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-black uppercase">
                  <span class="status-pulse status-pulse-active"></span> Active
                </span>
              <% } else if (discount.status === 'expired' || discount.expiryDate < new Date()) { %>
                <span class="px-2.5 py-1 rounded-full bg-red-100 text-red-800 text-[10px] font-black uppercase">Expired</span>
              <% } else { %>
                <span class="px-2.5 py-1 rounded-full bg-gray-100 text-gray-800 text-[10px] font-black uppercase">Disabled</span>
              <% } %>
            </td>
            <td class="px-8 py-6 text-right" onclick="event.stopPropagation()">
              <div class="flex items-center justify-end gap-2">
                <a href="/discounts/edit/<%= discount._id %>" class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-indigo-600 hover:text-white transition-all shadow-sm">
                  <i class="fas fa-edit text-xs"></i>
                </a>
                <a href="/discounts/delete/<%= discount._id %>" onclick="return confirm('Permanently delete this code?')" class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-red-600 hover:text-white transition-all shadow-sm">
                  <i class="fas fa-trash text-xs"></i>
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Mobile Card View -->
  <div class="md:hidden divide-y divide-gray-50">
     <% discounts.forEach(discount => { 
        const relTime = getRelativeTime(discount.expiryDate);
     %>
       <div class="p-5 flex flex-col gap-4 active:bg-gray-50 transition-colors" onclick="location.href='/discounts/edit/<%= discount._id %>'">
          <div class="flex justify-between items-center">
             <div class="flex items-center gap-2">
                <span class="code-badge text-xs"><%= discount.code %></span>
                <i class="fas fa-copy text-xs text-gray-300" onclick="copyCode('<%= discount.code %>', event)"></i>
             </div>
             <span class="text-xs font-black text-indigo-600">-<%= discount.value %><%= discount.type === 'percentage' ? '%' : '' %></span>
          </div>
          <div class="flex justify-between items-end mt-1">
             <div>
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1">Expiry</p>
                <p class="text-[11px] font-bold text-gray-700"><%= discount.expiryDate.toLocaleDateString() %></p>
                <span class="<%= relTime.color %> text-[9px] font-black uppercase"><%= relTime.text %></span>
             </div>
             <div class="text-right">
                <% if (discount.status === 'active' && discount.expiryDate >= new Date()) { %>
                  <span class="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 text-[9px] font-black uppercase">Active</span>
                <% } else { %>
                  <span class="px-2 py-0.5 rounded-full bg-red-50 text-red-600 text-[9px] font-black uppercase">Inactive</span>
                <% } %>
             </div>
          </div>
       </div>
     <% }) %>
  </div>

  <!-- Empty State -->
  <% if (discounts.length === 0) { %>
    <div class="py-24 text-center bg-gray-50/30">
        <div class="max-w-xs mx-auto">
           <div class="w-20 h-20 bg-white shadow-xl shadow-gray-200/50 rounded-3xl flex items-center justify-center mb-8 mx-auto transform rotate-6 border border-gray-100">
              <i class="fas fa-percent text-4xl text-indigo-200"></i>
           </div>
           <h3 class="text-2xl font-black text-gray-900 tracking-tight">No promotions yet</h3>
           <p class="text-gray-500 font-bold mt-2 text-sm px-4">Create your first discount code to boost sales and attract customers.</p>
           <a href="/discounts/add" class="mt-8 btn bg-indigo-600 text-white px-10 py-4 rounded-2xl shadow-xl shadow-indigo-100 font-black uppercase tracking-widest text-[10px]">Create First Code</a>
        </div>
    </div>
  <% } %>
</div>

<script>
  function copyCode(text, event) {
    event.stopPropagation();
    navigator.clipboard.writeText(text).then(() => {
      showToast('Code copied to clipboard!', 'success');
    });
  }
</script>

<%- include('../../layouts/footer') %>
