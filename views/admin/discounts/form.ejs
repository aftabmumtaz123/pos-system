<% 
  const currentPage = 'discounts';
  const title = discount ? 'Edit Discount - POS System' : 'Create Discount - POS System';
  const isEdit = !!discount;
%>
<%- include('../../layouts/header', { user, currentPage, title }) %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900"><%= isEdit ? 'Edit' : 'Create' %> Discount</h1>
    <p class="text-gray-600 mt-2"><%= isEdit ? 'Update discount information' : 'Create a new discount code' %></p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-4 p-4 bg-red-50 border-l-4 border-red-500 rounded">
      <p class="text-red-700"><i class="fas fa-exclamation-circle mr-2"></i><%= error %></p>
    </div>
  <% } %>

  <div class="card">
    <form action="<%= isEdit ? '/discounts/edit/' + discount._id : '/discounts/add' %>" method="POST">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="form-group">
          <label class="form-label">Discount Code *</label>
          <input 
            type="text" 
            name="code" 
            class="form-control uppercase" 
            value="<%= isEdit ? discount.code : '' %>"
            placeholder="e.g., SUMMER20"
            required
            style="text-transform: uppercase;"
          >
          <p class="text-xs text-gray-500 mt-1">Will be converted to uppercase</p>
        </div>

        <div class="form-group">
          <label class="form-label">Discount Type *</label>
          <select name="type" class="form-control" id="discountType" required>
            <option value="percentage" <%= isEdit && discount.type === 'percentage' ? 'selected' : '' %>>
              Percentage (%)
            </option>
            <option value="fixed" <%= isEdit && discount.type === 'fixed' ? 'selected' : '' %>>
              Fixed Amount (PKR)
            </option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Value *</label>
          <input 
            type="number" 
            name="value" 
            class="form-control" 
            step="0.01"
            min="0"
            value="<%= isEdit ? discount.value : '' %>"
            id="discountValue"
            required
          >
          <p class="text-xs text-gray-500 mt-1" id="valueHint">
            Enter percentage (e.g., 15 for 15%)
          </p>
        </div>

        <div class="form-group">
          <label class="form-label">Expiry Date *</label>
          <input 
            type="date" 
            name="expiryDate" 
            class="form-control" 
            value="<%= isEdit ? new Date(discount.expiryDate).toISOString().split('T')[0] : '' %>"
            min="<%= new Date().toISOString().split('T')[0] %>"
            required
          >
        </div>

        <% if (isEdit) { %>
          <div class="form-group">
            <label class="form-label">Status</label>
            <select name="status" class="form-control">
              <option value="active" <%= discount.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="expired" <%= discount.status === 'expired' ? 'selected' : '' %>>Expired</option>
            </select>
          </div>
        <% } %>
      </div>

      <div class="flex gap-3 mt-6">
        <button type="submit" class="btn btn-primary">
          <i class="fas fa-save"></i>
          <%= isEdit ? 'Update' : 'Create' %> Discount
        </button>
        <a href="/discounts" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i>
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  // Update value hint based on discount type
  const typeSelect = document.getElementById('discountType');
  const valueHint = document.getElementById('valueHint');
  const valueInput = document.getElementById('discountValue');

  function updateHint() {
    if (typeSelect.value === 'percentage') {
      valueHint.textContent = 'Enter percentage (e.g., 15 for 15%)';
      valueInput.max = '100';
    } else {
      valueHint.textContent = 'Enter amount in PKR (e.g., 200)';
      valueInput.removeAttribute('max');
    }
  }

  typeSelect.addEventListener('change', updateHint);
  updateHint();
</script>

<%- include('../../layouts/footer') %>
