<% 
  const currentPage = 'products';
  const title = 'Inventory - POS System';
%>
<%- include('../../layouts/header', { user, currentPage, title }) %>

<!-- Header and Metadata -->
<div class="mb-8 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
  <div>
    <h1 class="text-3xl font-black text-gray-900 tracking-tight">Product Inventory</h1>
    <p class="text-gray-500 font-medium mt-1">
      Showing <span class="text-indigo-600 font-bold"><%= products.length %></span> 
      of <span class="text-gray-900 font-bold"><%= totalProducts %></span> products
    </p>
  </div>
  <a href="/products/add" class="btn bg-indigo-600 hover:bg-indigo-700 text-white shadow-lg shadow-indigo-200 px-6 py-3 transition-all transform hover:-translate-y-1 rounded-xl">
    <i class="fas fa-plus mr-2"></i> Add New Product
  </a>
</div>

<!-- Filters and Search Area -->
<div class="card mb-8 p-6 bg-white border border-gray-100 shadow-sm rounded-2xl">
  <form method="GET" action="/products" id="filterForm" class="space-y-6">
    <!-- Top Row: Search and Sort -->
    <div class="flex flex-col md:flex-row gap-4">
      <div class="flex-1 relative">
        <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 transition-colors group-focus-within:text-indigo-600"></i>
        <input 
          type="text" 
          name="search" 
          id="productSearchInput"
          placeholder="Search by name, category..." 
          class="form-control pl-12 pr-10 py-3 search-field focus:ring-4 focus:ring-indigo-50 border-gray-100"
          value="<%= search %>"
          autocomplete="off"
        >
        <% if (search) { %>
          <span class="search-clear" style="display: block" onclick="clearSearch()">
            <i class="fas fa-times-circle"></i>
          </span>
        <% } %>
      </div>
      <div class="w-full md:w-64">
        <select name="sort" class="form-control py-3 font-semibold text-gray-700 cursor-pointer border-gray-100" onchange="this.form.submit()">
          <option value="">Sort: Default</option>
          <option value="name-asc" <%= sort === 'name-asc' ? 'selected' : '' %>>Name: A-Z</option>
          <option value="name-desc" <%= sort === 'name-desc' ? 'selected' : '' %>>Name: Z-A</option>
          <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="stock-asc" <%= sort === 'stock-asc' ? 'selected' : '' %>>Stock: Low to High</option>
          <option value="stock-desc" <%= sort === 'stock-desc' ? 'selected' : '' %>>Stock: High to Low</option>
          <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Date: Oldest First</option>
        </select>
      </div>
    </div>

    <!-- Bottom Row: Quick Filters -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2">Quick Filters:</span>
      <a href="/products" class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all <%= !filter ? 'bg-indigo-600 text-white shadow-md shadow-indigo-100' : 'bg-gray-50 text-gray-500 hover:bg-gray-100' %>">
        All (<%= counts.all %>)
      </a>
      <a href="/products?filter=low-stock" class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all <%= filter === 'low-stock' ? 'bg-amber-500 text-white shadow-md shadow-amber-100' : 'bg-amber-50 text-amber-600 hover:bg-amber-100' %>">
        Low Stock (<%= counts.lowStock %>)
      </a>
      <a href="/products?filter=out-of-stock" class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all <%= filter === 'out-of-stock' ? 'bg-red-500 text-white shadow-md shadow-red-100' : 'bg-red-50 text-red-600 hover:bg-red-100' %>">
        Out (<%= counts.outOfStock %>)
      </a>
      
      <div class="h-4 w-px bg-gray-200 mx-2"></div>
      
      <% counts.categories.slice(0, 5).forEach(cat => { %>
        <a href="/products?filter=<%= cat %>" class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all <%= filter === cat ? 'bg-indigo-100 text-indigo-700 shadow-sm' : 'bg-gray-50 text-gray-500 hover:bg-gray-100' %>">
          <%= cat %>
        </a>
      <% }) %>
    </div>
  </form>
</div>

<!-- Product Table -->
<div class="card overflow-hidden p-0 border-none shadow-xl bg-white rounded-2xl">
  <!-- Desktop Table -->
  <div class="hidden md:block overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-100">
          <th class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest text-center w-28">Media</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest">Product Info</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest">Category</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest">Pricing</th>
          <th class="px-6 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest">Availability</th>
          <th class="px-8 py-5 text-[10px] font-black text-gray-400 uppercase tracking-widest text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% products.forEach(product => { 
          const cleanCat = product.category ? product.category.toLowerCase().replace(/ /g, '-') : 'other';
          const catClass = `cat-${['snack', 'clothes', 'electronics', 'food', 'drink', 'cosmetics'].includes(cleanCat) ? cleanCat : 'other'}`;
        %>
          <tr class="product-row group transition-all hover:bg-indigo-50/30" onclick="location.href='/products/edit/<%= product._id %>'">
            <td class="px-8 py-4">
              <div class="product-avatar m-auto">
                <% if (product.image && product.image !== '/uploads/default-product.png') { %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="group-hover:scale-110 transition-transform duration-500">
                <% } else { %>
                  <div class="avatar-placeholder"><%= product.name.slice(0, 2) %></div>
                <% } %>
              </div>
            </td>
            <td class="px-6 py-4">
              <p class="text-base font-black text-gray-900 tracking-tight group-hover:text-indigo-600 transition-colors"><%= product.name %></p>
              <div class="mt-1 flex items-center gap-1 opacity-60">
                <span class="text-[9px] font-black text-gray-500 uppercase tracking-widest">DESC:</span>
                <p class="text-[11px] text-gray-600 font-bold line-clamp-1"><%= product.description || 'No description' %></p>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase tracking-tighter <%= catClass %>">
                <%= product.category || 'N/A' %>
              </span>
            </td>
            <td class="px-6 py-4">
              <p class="text-base font-black text-gray-900 tracking-tighter">PKR <%= product.price.toLocaleString() %></p>
            </td>
            <td class="px-6 py-4">
              <% if (product.stock === 0) { %>
                <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-lg bg-red-50 text-red-600 text-[9px] font-black uppercase tracking-tight">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-600"></span> Sold Out
                </span>
              <% } else if (product.stock < 5) { %>
                <div class="flex flex-col gap-1">
                  <span class="text-amber-600 text-[9px] font-black uppercase tracking-tight">Low Stock (<%= product.stock %>)</span>
                  <div class="w-20 h-1.5 bg-gray-100 rounded-full overflow-hidden">
                    <div class="bg-amber-500 h-full" style="width: <%= (product.stock / 5) * 100 %>%"></div>
                  </div>
                </div>
              <% } else { %>
                <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded-lg bg-emerald-50 text-emerald-600 text-[9px] font-black uppercase tracking-tight">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 animate-pulse"></span> <%= product.stock %> Units
                </span>
              <% } %>
            </td>
            <td class="px-8 py-4 text-right" onclick="event.stopPropagation()">
              <div class="flex items-center justify-end gap-2">
                <a href="/products/edit/<%= product._id %>" class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-indigo-600 hover:text-white hover:border-indigo-600 transition-all action-icon shadow-sm">
                  <i class="fas fa-edit text-xs"></i>
                </a>
                <a href="/products/delete/<%= product._id %>" 
                   onclick="return confirm('Permanently delete this product?')"
                   class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-gray-400 hover:bg-red-600 hover:text-white hover:border-red-600 transition-all action-icon shadow-sm"
                >
                  <i class="fas fa-trash text-xs"></i>
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Mobile Card List -->
  <div class="md:hidden divide-y divide-gray-50 bg-white">
     <% products.forEach(product => { 
        const cleanCat = product.category ? product.category.toLowerCase().replace(/ /g, '-') : 'other';
        const catClass = `cat-${['snack', 'clothes', 'electronics', 'food', 'drink', 'cosmetics'].includes(cleanCat) ? cleanCat : 'other'}`;
     %>
        <div class="p-5 flex gap-4 active:bg-gray-50 transition-colors" onclick="location.href='/products/edit/<%= product._id %>'">
           <div class="product-avatar w-20 h-20 min-w-[80px] rounded-2xl shadow-sm border-2 border-white bg-gray-50 flex items-center justify-center overflow-hidden">
                <% if (product.image && product.image !== '/uploads/default-product.png') { %>
                  <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-full object-cover">
                <% } else { %>
                  <div class="text-xl font-black text-indigo-400 uppercase"><%= product.name.slice(0, 2) %></div>
                <% } %>
           </div>
           <div class="flex-1">
              <div class="flex justify-between items-start">
                 <p class="text-sm font-black text-gray-900 tracking-tight line-clamp-1"><%= product.name %></p>
                 <p class="text-xs font-black text-indigo-600 ml-2">PKR <%= product.price %></p>
              </div>
              <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest mt-1 mb-3"><%= product.category || 'Uncategorized' %></p>
              <div class="flex justify-between items-center">
                  <% if (product.stock === 0) { %>
                    <span class="text-[9px] font-black text-red-500 uppercase tracking-tight">Sold Out</span>
                  <% } else { %>
                    <span class="text-[9px] font-black text-emerald-600 uppercase tracking-tight"><%= product.stock %> in stock</span>
                  <% } %>
                  <div class="flex gap-2" onclick="event.stopPropagation()">
                    <a href="/products/edit/<%= product._id %>" class="text-indigo-400 hover:text-indigo-600 p-1"><i class="fas fa-edit"></i></a>
                  </div>
              </div>
           </div>
        </div>
     <% }) %>
  </div>

  <% if (products.length === 0) { %>
     <div class="py-24 text-center bg-gray-50/50">
        <div class="max-w-xs mx-auto flex flex-col items-center">
           <div class="w-20 h-20 bg-white shadow-xl shadow-gray-200/50 rounded-3xl flex items-center justify-center mb-8 transform -rotate-12">
              <i class="fas fa-box-open text-4xl text-indigo-200"></i>
           </div>
           <h3 class="text-2xl font-black text-gray-900 tracking-tight">Empty Inventory</h3>
           <p class="text-gray-500 font-bold mt-2 text-sm">We couldn't find any products matching your criteria.</p>
           <a href="/products/add" class="mt-8 btn bg-indigo-600 text-white px-10 py-4 rounded-2xl shadow-xl shadow-indigo-100 font-black uppercase tracking-widest text-[10px]">Add First Product</a>
        </div>
     </div>
  <% } %>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <div class="bg-gray-50/50 px-8 py-6 border-t border-gray-50 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">
        Showing Page <span class="text-indigo-600"><%= currentPage %></span> of <span class="text-gray-900"><%= totalPages %></span>
      </p>
      <div class="flex items-center gap-1.5">
        <% if (currentPage > 1) { %>
          <a href="/products?page=<%= currentPage - 1 %>&search=<%= search %>&sort=<%= sort %>&filter=<%= filter %>" class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-gray-500 hover:text-indigo-600 hover:border-indigo-600 transition-all shadow-sm">
            <i class="fas fa-chevron-left text-[10px]"></i>
          </a>
        <% } %>
        
        <% 
          let start = Math.max(1, currentPage - 2);
          let end = Math.min(totalPages, start + 4);
          if (end - start < 4) start = Math.max(1, end - 4);
        %>

        <% for(let i = start; i <= end; i++) { %>
           <% if (i === currentPage) { %>
              <span class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center text-white font-black text-[10px] shadow-lg shadow-indigo-100">
                <%= i %>
              </span>
           <% } else { %>
              <a href="/products?page=<%= i %>&search=<%= search %>&sort=<%= sort %>&filter=<%= filter %>" class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-gray-500 font-black text-[10px] hover:text-indigo-600 hover:border-indigo-600 transition-all shadow-sm">
                <%= i %>
              </a>
           <% } %>
        <% } %>

        <% if (currentPage < totalPages) { %>
          <a href="/products?page=<%= currentPage + 1 %>&search=<%= search %>&sort=<%= sort %>&filter=<%= filter %>" class="w-9 h-9 rounded-xl bg-white border border-gray-100 flex items-center justify-center text-gray-500 hover:text-indigo-600 hover:border-indigo-600 transition-all shadow-sm">
            <i class="fas fa-chevron-right text-[10px]"></i>
          </a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<script>
  function clearSearch() {
    window.location.href = '/products';
  }

  // Smooth Search Logic
  const searchInput = document.getElementById('productSearchInput');
  if (searchInput) {
    searchInput.addEventListener('keypress', function (e) {
      if (e.key === 'Enter') {
        this.form.submit();
      }
    });
  }
</script>

<%- include('../../layouts/footer') %>
