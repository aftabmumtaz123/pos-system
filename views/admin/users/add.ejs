<% 
  const currentPage = 'users';
  const title = 'Add Team Member - POS System';
%>
<%- include('../../layouts/header', { user, currentPage, title }) %>

<div class="max-w-xl mx-auto py-12">
  <div class="mb-10 text-center">
    <div class="w-16 h-16 bg-indigo-50 rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-sm">
      <i class="fas fa-user-plus text-2xl text-indigo-600"></i>
    </div>
    <h1 class="text-3xl font-black text-gray-900 tracking-tight">Add Team Member</h1>
    <p class="text-gray-500 font-medium mt-2">Create a new cashier or administrator account.</p>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-6 p-4 bg-red-50 border border-red-100 rounded-2xl flex items-center gap-3 animate-fade-up">
      <div class="w-8 h-8 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">
        <i class="fas fa-exclamation-circle text-xs"></i>
      </div>
      <p class="text-red-700 font-bold text-sm"><%= error %></p>
    </div>
  <% } %>

  <div class="card bg-white border border-gray-100 shadow-xl rounded-3xl p-8">
    <form action="/users/add" method="POST" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Username *</label>
          <input 
            type="text" 
            name="username" 
            class="form-control py-3.5 font-bold border-gray-100 focus:ring-4 focus:ring-indigo-50 rounded-xl"
            required
            placeholder="e.g. jhon_doe"
            value="<%= formData.username || '' %>"
          >
        </div>

        <div>
           <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Full Email *</label>
           <input 
             type="email" 
             name="email" 
             class="form-control py-3.5 font-bold border-gray-100 focus:ring-4 focus:ring-indigo-50 rounded-xl"
             required
             placeholder="john@example.com"
             value="<%= formData.email || '' %>"
           >
        </div>
      </div>

      <div>
        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Initial Password *</label>
        <div class="relative">
          <input 
            type="password" 
            name="password" 
            class="form-control py-3.5 font-bold border-gray-100 focus:ring-4 focus:ring-indigo-50 rounded-xl pl-4"
            minlength="6"
            required
            placeholder="••••••••"
          >
        </div>
        <p class="text-[10px] text-gray-400 mt-2 font-bold italic">Security Note: Must be at least 6 characters.</p>
      </div>

      <div>
        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Privilege Role</label>
        <select name="role" class="form-control py-3.5 font-bold border-gray-100 focus:ring-4 focus:ring-indigo-50 rounded-xl cursor-pointer">
          <option value="cashier" <%= formData.role === 'cashier' ? 'selected' : '' %>>Cashier (Restricted Access)</option>
          <option value="super_admin" <%= formData.role === 'super_admin' ? 'selected' : '' %>>Super Admin (Full Access)</option>
        </select>
      </div>

      <div class="pt-4 flex flex-col sm:flex-row gap-4">
        <button type="submit" class="flex-1 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-black uppercase tracking-widest text-[10px] rounded-2xl shadow-lg shadow-indigo-100 transition-all transform hover:-translate-y-0.5">
          <i class="fas fa-check-circle mr-2 text-xs"></i> Register Member
        </button>
        <a href="/users" class="px-8 py-4 bg-gray-50 hover:bg-gray-100 text-gray-500 font-black uppercase tracking-widest text-[10px] rounded-2xl text-center transition-all">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>

<%- include('../../layouts/footer') %>
