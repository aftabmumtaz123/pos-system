<% 
  const currentPage = 'pos';
  const title = 'Point of Sale - POS System';
  const customStyles = `
    .pos-container {
      display: grid;
      grid-template-columns: 1fr 400px;
      gap: 1.5rem;
      height: calc(100vh - 8rem);
    }
    @media (max-width: 1024px) {
      .pos-container {
        grid-template-columns: 1fr;
        height: auto;
      }
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
      max-height: calc(100vh - 16rem);
      overflow-y: auto;
    }
    .cart-panel {
      position: sticky;
      top: 1rem;
      height: fit-content;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
    }
  `;
%>
<%- include('../layouts/header', { user, currentPage, title, customStyles }) %>

<div class="mb-4">
  <h1 class="text-3xl font-bold text-gray-900">Point of Sale</h1>
  <p class="text-gray-600 mt-1">Scan or select products to add to cart</p>
</div>

<div class="pos-container">
  <!-- Left Panel - Products -->
  <div>
    <!-- Search Bar -->
    <div class="mb-4">
      <div class="relative">
        <input 
          type="text" 
          id="productSearch" 
          placeholder="Search products by name or category..." 
          class="form-control pl-10"
        >
        <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
      </div>
    </div>

    <!-- Top Sellers -->
    <div class="mb-6">
      <div class="flex justify-between items-center mb-3">
        <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
          <i class="fas fa-fire text-orange-500"></i>
          Top Sellers
        </h2>
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-widest">Quick Access</span>
      </div>
      <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide">
        <% products.slice(0, 6).forEach(product => { %>
          <div 
            class="flex-shrink-0 w-40 bg-white border border-gray-100 rounded-2xl p-3 hover:shadow-md transition-all cursor-pointer group product-card"
            data-id="<%= product._id %>"
            data-name="<%= product.name %>"
            data-price="<%= product.price %>"
            data-stock="<%= product.stock %>"
            data-image="<%= product.image %>"
          >
            <div class="h-24 w-full rounded-xl overflow-hidden mb-2 bg-gray-50">
              <img src="<%= product.image %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='/uploads/default-product.png'">
            </div>
            <h4 class="text-xs font-bold text-gray-800 truncate mb-1"><%= product.name %></h4>
            <p class="text-xs font-black text-indigo-600">PKR <%= product.price.toLocaleString() %></p>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Search Bar -->
    <div class="product-grid" id="productsGrid">
      <% products.forEach(product => { %>
        <div 
          class="pos-product-card product-card" 
          data-id="<%= product._id %>"
          data-name="<%= product.name %>"
          data-price="<%= product.price %>"
          data-stock="<%= product.stock %>"
          data-category="<%= product.category || '' %>"
          data-image="<%= product.image %>"
        >
          <div class="pos-product-image-wrapper">
            <img 
              src="<%= product.image %>" 
              alt="<%= product.name %>" 
              class="pos-product-image"
              onerror="this.src='/uploads/default-product.png'"
            >
            <div class="stock-badge <%= product.stock < 5 ? 'stock-low' : (product.stock < 20 ? 'stock-medium' : 'stock-high') %>">
              <%= product.stock %> in stock
            </div>
          </div>
          
          <div class="pos-product-info">
            <span class="pos-product-category"><%= product.category || 'Uncategorized' %></span>
            <h3 class="pos-product-name truncate"><%= product.name %></h3>
            
            <div class="mt-auto flex justify-between items-center">
              <span class="pos-product-price">PKR <%= product.price.toLocaleString() %></span>
              <button class="btn btn-primary p-2 rounded-xl">
                <i class="fas fa-plus"></i>
              </button>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (products.length === 0) { %>
        <div class="col-span-full text-center text-gray-400 py-16">
          <div class="bg-gray-50 inline-flex p-6 rounded-full mb-4">
            <i class="fas fa-search text-4xl"></i>
          </div>
          <p class="text-xl font-medium">No products found</p>
          <button onclick="location.reload()" class="mt-4 text-indigo-600 font-semibold">Clear filters</button>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Right Panel - Cart -->
  <div class="cart-panel">
    <div class="card">
      <h2 class="text-xl font-bold text-gray-900 mb-4 flex items-center gap-2">
        <i class="fas fa-shopping-cart text-indigo-600"></i>
        Cart
        <span id="cartCount" class="ml-auto text-sm bg-indigo-100 text-indigo-600 px-2 py-1 rounded-full">0</span>
      </h2>

      <!-- Cart Items -->
      <div id="cartItems" class="space-y-2 mb-4 max-h-64 overflow-y-auto">
        <p class="text-gray-500 text-center py-8 text-sm">Cart is empty</p>
      </div>

      <!-- Discount Section -->
      <div class="border-t pt-4 mb-4">
        <label class="form-label text-sm">Discount Code</label>
        <div class="flex gap-2">
          <input 
            type="text" 
            id="discountCode" 
            placeholder="Enter code" 
            class="form-control text-sm uppercase"
            style="text-transform: uppercase;"
          >
          <button 
            onclick="applyDiscount()" 
            class="btn btn-secondary text-sm px-4"
          >
            Apply
          </button>
        </div>
        <div id="discountInfo" class="mt-2 hidden">
          <div class="flex justify-between items-center text-sm p-2 bg-green-50 rounded-lg border border-green-100">
            <span class="text-green-700 font-bold flex items-center gap-2">
              <i class="fas fa-check-circle"></i>
              <span id="discountLabel"></span>
            </span>
            <button onclick="removeDiscount()" class="text-green-700 hover:text-red-600 transition-colors">
              <i class="fas fa-times-circle"></i>
            </button>
          </div>
        </div>
      </div>

      <!-- Summary -->
      <div class="border-t pt-4 space-y-2 mb-4">
        <!-- Customer Info (Tier 3) -->
        <div class="mb-4">
          <div class="relative">
            <input 
              type="text" 
              id="customerInfo" 
              placeholder="Customer Name / Phone (Optional)" 
              class="form-control text-xs pl-8"
            >
            <i class="fas fa-user absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400 text-xs"></i>
          </div>
        </div>

        <div class="flex justify-between text-sm">
          <span class="text-gray-600">Subtotal:</span>
          <span class="font-semibold" id="subtotal">PKR 0.00</span>
        </div>
        <div class="flex justify-between text-sm" id="discountRow" style="display: none;">
          <span class="text-gray-600">Discount:</span>
          <span class="font-semibold text-green-600" id="discountAmount">- PKR 0.00</span>
        </div>
        <div class="flex justify-between text-lg font-bold border-t pt-2">
          <span>Total:</span>
          <span class="text-indigo-600" id="total">PKR 0.00</span>
        </div>
      </div>

      <!-- Payment Method -->
      <div class="mb-4">
        <label class="form-label text-sm">Payment Method</label>
        <div class="grid grid-cols-2 gap-2 mb-3">
          <button type="button" onclick="setPaymentMethod('cash')" class="payment-type-btn active" id="btn-cash">
            <i class="fas fa-wallet"></i> Cash
          </button>
          <button type="button" onclick="setPaymentMethod('card')" class="payment-type-btn" id="btn-card">
            <i class="fas fa-credit-card"></i> Card
          </button>
          <button type="button" onclick="setPaymentMethod('easypaisa')" class="payment-type-btn" id="btn-easypaisa">
            <i class="fas fa-mobile-alt"></i> EasyPaisa
          </button>
          <button type="button" onclick="setPaymentMethod('jazzcash')" class="payment-type-btn" id="btn-jazzcash">
            <i class="fas fa-mobile-alt"></i> JazzCash
          </button>
        </div>
        <select id="paymentMethod" class="hidden">
          <option value="cash">Cash</option>
          <option value="card">Card</option>
          <option value="easypaisa">EasyPaisa</option>
          <option value="jazzcash">JazzCash</option>
        </select>

        <!-- Cash Details (Shown when cash selected) -->
        <div id="cashDetails" class="space-y-2 mt-3 animate-fade-in">
          <div class="bg-gray-50 p-3 rounded-xl border border-gray-100">
            <div class="flex justify-between items-center mb-2">
              <span class="text-xs font-bold text-gray-500 uppercase">Received</span>
              <input 
                type="number" 
                id="cashReceived" 
                class="w-24 text-right font-black text-lg bg-transparent border-b-2 border-indigo-200 focus:border-indigo-600 outline-none p-1"
                placeholder="0.00"
                oninput="calculateChange()"
              >
            </div>
            <div class="flex justify-between items-center">
              <span class="text-xs font-bold text-gray-500 uppercase">Change</span>
              <span class="font-black text-xl text-green-600" id="changeAmount">PKR 0.00</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="space-y-2">
        <button 
          onclick="checkout()" 
          class="w-full btn btn-success text-lg py-4"
          id="checkoutBtn"
        >
          <i class="fas fa-check-circle"></i>
          Pay Now
        </button>
        <div class="grid grid-cols-2 gap-2">
          <button 
            onclick="parkSale()" 
            class="btn btn-secondary text-xs flex justify-center"
            title="Save for later"
          >
            <i class="fas fa-pause"></i> Park Sale
          </button>
          <button 
            onclick="resumeSale()" 
            class="btn btn-secondary text-xs flex justify-center"
            id="resumeBtn"
          >
            <i class="fas fa-play"></i> Resume
          </button>
        </div>
        <button 
          onclick="clearCart()" 
          class="w-full btn btn-secondary text-sm"
        >
          <i class="fas fa-trash"></i>
          Clear Cart
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Cart Panel (Continued) -->
<%- include('../layouts/footer') %>

<!-- Receipt Preview Modal (Tier 3) -->
<div id="receiptModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl w-full max-w-md overflow-hidden animate-fade-up">
    <div class="p-6 border-b border-dashed flex justify-between items-center bg-gray-50">
      <div class="flex items-center gap-3">
        <% if (settings.logo && settings.logo !== '/uploads/default-logo.png') { %>
          <img src="<%= settings.logo %>" class="h-8 w-auto grayscale opacity-70">
        <% } else { %>
          <div class="w-8 h-8 bg-gray-200 rounded flex items-center justify-center">
            <i class="fas fa-receipt text-gray-400"></i>
          </div>
        <% } %>
        <h3 class="font-black text-sm text-gray-900 uppercase tracking-tighter"><%= settings.brandName || settings.businessName || 'Order Review' %></h3>
      </div>
      <button onclick="closeReceiptModal()" class="text-gray-400 hover:text-gray-600">
        <i class="fas fa-times text-xl"></i>
      </button>
    </div>
    
    <div class="p-8 space-y-4 max-h-[60vh] overflow-y-auto">
      <div class="text-center mb-6">
        <div class="bg-indigo-100 text-indigo-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-receipt text-2xl"></i>
        </div>
        <p class="text-sm text-gray-500">Please review items and total</p>
      </div>

      <div id="modalOrderItems" class="space-y-2">
        <!-- Injected via JS -->
      </div>
      
      <div class="border-t border-dashed pt-4 space-y-2">
        <div class="flex justify-between text-sm text-gray-500">
          <span>Subtotal</span>
          <span id="modalSubtotal">PKR 0.00</span>
        </div>
        <div class="flex justify-between text-sm text-green-600" id="modalDiscountRow" style="display: none;">
          <span>Discount Applied</span>
          <span id="modalDiscount">PKR 0.00</span>
        </div>
        <div class="flex justify-between text-2xl font-black text-gray-900 pt-2">
          <span>Total</span>
          <span id="modalTotal" class="text-indigo-600">PKR 0.00</span>
        </div>
      </div>

      <div class="bg-gray-50 p-4 rounded-2xl space-y-3">
        <div class="flex justify-between items-center">
          <span class="text-xs font-bold text-gray-400 uppercase">Payment</span>
          <span id="modalPaymentMethod" class="text-sm font-black uppercase text-indigo-600">---</span>
        </div>
        <div id="modalCashDetails" class="hidden flex justify-between items-center border-t border-gray-200 pt-2">
          <span class="text-xs font-bold text-gray-400 uppercase">Change</span>
          <span id="modalChange" class="text-sm font-black text-green-600">PKR 0.00</span>
        </div>
      </div>
    </div>
    
    <div class="p-6 bg-gray-50 flex gap-4">
      <button onclick="closeReceiptModal()" class="flex-1 btn btn-secondary text-sm">
        Back to Edit
      </button>
      <button onclick="confirmCheckout()" class="flex-1 btn btn-success text-sm py-4">
        Confirm & Pay
      </button>
    </div>
  </div>
</div>

<script>
  const settings = <%- JSON.stringify(settings) %>;
  let cart = [];
  let currentDiscount = null;

  // Add to cart
  function addToCart(id, name, price, stock, image) {
    const existingItem = cart.find(item => item.productId === id);
    
    if (existingItem) {
      if (existingItem.quantity >= stock) {
        Toast.warning(`Only ${stock} items available in stock`);
        return;
      }
      existingItem.quantity++;
      Toast.success(`${name} quantity updated to ${existingItem.quantity}`);
    } else {
      cart.push({ productId: id, name, price, quantity: 1, stock, image });
      Toast.success(`${name} added to cart`);
    }
    
    // Add bounce animation to cart icon
    const cartIcon = document.querySelector('.fa-shopping-cart');
    cartIcon.parentElement.classList.add('cart-pulse');
    setTimeout(() => cartIcon.parentElement.classList.remove('cart-pulse'), 400);

    updateCart();
  }

  // Update quantity
  function updateQuantity(id, delta) {
    const item = cart.find(item => item.productId === id);
    if (!item) return;

    const newQuantity = item.quantity + delta;
    
    if (newQuantity <= 0) {
      removeFromCart(id);
      return;
    }
    
    if (newQuantity > item.stock) {
      Toast.warning('Not enough stock');
      return;
    }
    
    item.quantity = newQuantity;
    updateCart();
  }

  // Remove from cart
  function removeFromCart(id) {
    cart = cart.filter(item => item.productId !== id);
    updateCart();
  }

  // Update cart display
  function updateCart() {
    const cartItems = document.getElementById('cartItems');
    const cartCount = document.getElementById('cartCount');
    
    if (cart.length === 0) {
      cartItems.innerHTML = `
        <div class="text-center py-12">
          <div class="bg-gray-50 inline-flex p-4 rounded-full mb-3 text-gray-300">
            <i class="fas fa-shopping-basket text-3xl"></i>
          </div>
          <p class="text-gray-400 text-sm">Your cart is empty</p>
        </div>
      `;
      cartCount.textContent = '0';
    } else {
      // Calculate total QUANTITY of items
      const totalQty = cart.reduce((sum, item) => sum + item.quantity, 0);
      cartCount.textContent = totalQty;
      
      cartItems.innerHTML = cart.map((item, index) => `
        <div class="cart-item-row item-added" style="animation-delay: ${index * 0.05}s">
          <img src="${item.image}" class="cart-item-img" onerror="this.src='/uploads/default-product.png'">
          
          <div>
            <p class="font-bold text-sm text-gray-900 truncate" style="max-width: 140px;">${item.name}</p>
            <p class="font-bold text-indigo-600 text-xs">PKR ${item.price.toLocaleString()}</p>
          </div>
          
          <div class="qty-control">
            <button 
              onclick="updateQuantity('${item.productId}', -1)" 
              class="qty-btn"
              ${item.quantity <= 0 ? 'disabled' : ''}
            >
              <i class="fas fa-minus text-[10px]"></i>
            </button>
            <span class="w-8 text-center font-bold text-sm">${item.quantity}</span>
            <button 
              onclick="updateQuantity('${item.productId}', 1)" 
              class="qty-btn"
              ${item.quantity >= item.stock ? 'disabled' : ''}
            >
              <i class="fas fa-plus text-[10px]"></i>
            </button>
          </div>
          
          <div class="flex flex-col items-end gap-1">
            <button 
              onclick="removeFromCart('${item.productId}')" 
              class="remove-btn"
              title="Remove item"
            >
              <i class="fas fa-times"></i>
            </button>
            <span class="font-black text-xs text-gray-900">
              PKR ${(item.price * item.quantity).toLocaleString()}
            </span>
          </div>
        </div>
      `).join('');
    }
    
    calculateTotal();
  }

  // Calculate total
  function calculateTotal() {
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    let discountAmount = 0;

    if (currentDiscount) {
      if (currentDiscount.type === 'percentage') {
        discountAmount = (subtotal * currentDiscount.value) / 100;
      } else {
        discountAmount = currentDiscount.value;
      }
    }

    const total = subtotal - discountAmount;

    document.getElementById('subtotal').textContent = 'PKR ' + subtotal.toFixed(2);
    document.getElementById('discountAmount').textContent = '- PKR ' + discountAmount.toFixed(2);
    document.getElementById('total').textContent = 'PKR ' + total.toFixed(2);
    
    if (discountAmount > 0) {
      document.getElementById('discountRow').style.display = 'flex';
    } else {
      document.getElementById('discountRow').style.display = 'none';
    }
  }

  // Apply discount
  async function applyDiscount() {
    const code = document.getElementById('discountCode').value.trim();
    if (!code) {
      Toast.warning('Please enter a discount code');
      return;
    }

    try {
      const response = await fetch('/discounts/validate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code })
      });

      const data = await response.json();

      if (data.valid) {
        currentDiscount = data.discount;
        document.getElementById('discountInfo').classList.remove('hidden');
        document.getElementById('discountLabel').textContent = 
          `${data.discount.code} (${data.discount.type === 'percentage' ? data.discount.value + '%' : 'PKR ' + data.discount.value})`;
        Toast.success('Discount applied!');
        calculateTotal();
      } else {
        Toast.error(data.message || 'Invalid discount code');
      }
    } catch (error) {
      Toast.error('Error validating discount');
    }
  }

  // Remove discount
  function removeDiscount() {
    currentDiscount = null;
    document.getElementById('discountCode').value = '';
    document.getElementById('discountInfo').classList.add('hidden');
    calculateTotal();
    Toast.info('Discount removed');
  }

  // Clear cart
  function clearCart() {
    if (cart.length === 0) return;
    
    if (confirm('Are you sure you want to clear the cart?')) {
      cart = [];
      currentDiscount = null;
      document.getElementById('discountCode').value = '';
      document.getElementById('discountInfo').classList.add('hidden');
      updateCart();
      Toast.info('Cart cleared');
    }
  }

  // Checkout
  function checkout() {
    if (cart.length === 0) {
      Toast.warning('Cart is empty');
      return;
    }

    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    let discountAmount = 0;
    if (currentDiscount) {
      discountAmount = currentDiscount.type === 'percentage' ? (subtotal * currentDiscount.value) / 100 : currentDiscount.value;
    }
    const total = subtotal - discountAmount;
    const paymentMethod = document.getElementById('paymentMethod').value;
    const cashReceived = parseFloat(document.getElementById('cashReceived').value) || 0;

    if (paymentMethod === 'cash' && cashReceived < total) {
      Toast.warning(`Insufficient cash received. Need at least PKR ${total.toLocaleString()}`);
      return;
    }

    // Populate and show Review Modal
    document.getElementById('modalOrderItems').innerHTML = cart.map(item => `
      <div class="flex justify-between text-sm">
        <span class="text-gray-600 font-medium">${item.name} × ${item.quantity}</span>
        <span class="text-gray-900 font-bold">PKR ${(item.price * item.quantity).toLocaleString()}</span>
      </div>
    `).join('');
    
    document.getElementById('modalSubtotal').textContent = 'PKR ' + subtotal.toLocaleString();
    if (discountAmount > 0) {
      document.getElementById('modalDiscountRow').style.display = 'flex';
      document.getElementById('modalDiscount').textContent = '- PKR ' + discountAmount.toLocaleString();
    } else {
      document.getElementById('modalDiscountRow').style.display = 'none';
    }
    document.getElementById('modalTotal').textContent = 'PKR ' + total.toLocaleString();
    document.getElementById('modalPaymentMethod').textContent = paymentMethod;
    
    if (paymentMethod === 'cash') {
      document.getElementById('modalCashDetails').classList.remove('hidden');
      const change = Math.max(0, cashReceived - total);
      document.getElementById('modalChange').textContent = 'PKR ' + change.toLocaleString();
    } else {
      document.getElementById('modalCashDetails').classList.add('hidden');
    }

    document.getElementById('receiptModal').classList.remove('hidden');
  }

  function closeReceiptModal() {
    document.getElementById('receiptModal').classList.add('hidden');
  }

  // Confirm Checkout after review
  async function confirmCheckout() {
    const paymentMethod = document.getElementById('paymentMethod').value;
    const checkoutBtn = document.getElementById('checkoutBtn');
    const cashReceived = parseFloat(document.getElementById('cashReceived').value) || 0;
    
    closeReceiptModal();
    checkoutBtn.disabled = true;
    checkoutBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

    try {
      const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      let discountAmount = 0;
      if (currentDiscount) {
        discountAmount = currentDiscount.type === 'percentage' ? (subtotal * currentDiscount.value) / 100 : currentDiscount.value;
      }
      const total = subtotal - discountAmount;
      const changeAmount = Math.max(0, cashReceived - total);
      const customerInfo = document.getElementById('customerInfo').value;

      const response = await fetch('/pos/checkout', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          items: cart.map(item => ({
            productId: item.productId,
            quantity: item.quantity
          })),
          discountId: currentDiscount?._id,
          paymentMethod,
          cashReceived,
          changeAmount,
          customerInfo
        })
      });

      const data = await response.json();

      if (data.success) {
        Toast.success(data.message);
        window.open('/pos/receipt/' + data.saleId, '_blank');
        cart = [];
        currentDiscount = null;
        document.getElementById('discountCode').value = '';
        document.getElementById('discountInfo').classList.add('hidden');
        document.getElementById('cashReceived').value = '';
        document.getElementById('changeAmount').textContent = 'PKR 0.00';
        localStorage.removeItem('parkedCart'); // Clear parked sale on success
        updateCart();
      } else {
        Toast.error(data.message);
      }
    } catch (error) {
      Toast.error('Checkout failed. Please try again.');
    } finally {
      checkoutBtn.disabled = false;
      checkoutBtn.innerHTML = '<i class="fas fa-check-circle"></i> Pay Now';
    }
  }

  // Park Sale (Tier 3)
  function parkSale() {
    if (cart.length === 0) {
      Toast.warning('Cannot park an empty cart');
      return;
    }
    
    const parkedData = {
      cart,
      currentDiscount,
      customerInfo: document.getElementById('customerInfo').value,
      timestamp: new Date().getTime()
    };
    
    localStorage.setItem('parkedCart', JSON.stringify(parkedData));
    Toast.success('Sale parked successfully!');
    cart = [];
    currentDiscount = null;
    document.getElementById('customerInfo').value = '';
    updateCart();
  }

  // Resume Sale
  function resumeSale() {
    const data = localStorage.getItem('parkedCart');
    if (!data) {
      Toast.info('No parked sale found');
      return;
    }
    
    const parkedData = JSON.parse(data);
    cart = parkedData.cart;
    currentDiscount = parkedData.currentDiscount;
    document.getElementById('customerInfo').value = parkedData.customerInfo || '';
    
    if (currentDiscount) {
      document.getElementById('discountInfo').classList.remove('hidden');
      document.getElementById('discountLabel').textContent = 
        `${currentDiscount.code} (${currentDiscount.type === 'percentage' ? currentDiscount.value + '%' : 'PKR ' + currentDiscount.value})`;
    }
    
    updateCart();
    Toast.success('Parked sale resumed');
    localStorage.removeItem('parkedCart');
  }

  // Initialize: Check for parked sale
  window.addEventListener('DOMContentLoaded', () => {
    if (localStorage.getItem('parkedCart')) {
      Toast.info('You have a parked sale. Click "Resume" to continue.', {
        action: {
          text: 'Resume',
          callback: resumeSale
        }
      });
    }
  });

  // Payment method switcher
  function setPaymentMethod(method) {
    document.getElementById('paymentMethod').value = method;
    
    // Update button UI
    document.querySelectorAll('.payment-type-btn').forEach(btn => btn.classList.remove('active'));
    document.getElementById(`btn-${method}`).classList.add('active');
    
    // Show/hide cash details
    const cashDetails = document.getElementById('cashDetails');
    if (method === 'cash') {
      cashDetails.classList.remove('hidden');
    } else {
      cashDetails.classList.add('hidden');
    }
  }

  // Calculate change
  function calculateChange() {
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    let discountAmount = 0;
    if (currentDiscount) {
      discountAmount = currentDiscount.type === 'percentage' ? (subtotal * currentDiscount.value) / 100 : currentDiscount.value;
    }
    const total = subtotal - discountAmount;
    const received = parseFloat(document.getElementById('cashReceived').value) || 0;
    const change = Math.max(0, received - total);
    
    document.getElementById('changeAmount').textContent = 'PKR ' + change.toLocaleString();
    
    if (received >= total && total > 0) {
      document.getElementById('changeAmount').classList.replace('text-green-600', 'text-green-600'); // Ensure green
    } else if (received > 0) {
      document.getElementById('changeAmount').classList.replace('text-green-600', 'text-red-600');
    }
  }

  // Product search
  document.getElementById('productSearch').addEventListener('input', function(e) {
    const search = e.target.value.toLowerCase();
    const cards = document.querySelectorAll('.product-card');
    
    cards.forEach(card => {
      const name = card.dataset.name.toLowerCase();
      const category = card.dataset.category.toLowerCase();
      
      if (name.includes(search) || category.includes(search)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  });

  // Keyboard shortcut: Enter to focus search
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && e.target.id !== 'productSearch' && e.target.id !== 'discountCode') {
      document.getElementById('productSearch').focus();
    }
  });

  // Delegated Click Handler for products (Refactor to fix lint errors)
  document.addEventListener('click', (e) => {
    const card = e.target.closest('.product-card');
    if (card) {
      const { id, name, price, stock, image } = card.dataset;
      addToCart(id, name, parseFloat(price), parseInt(stock), image);
    }
  });
</script>

