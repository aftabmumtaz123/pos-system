<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>403 - Access Denied</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gradient-to-br from-red-600 via-orange-600 to-yellow-500 min-h-screen flex items-center justify-center p-4">
  <div class="text-center">
    <div class="mb-8">
      <i class="fas fa-lock text-white text-8xl mb-4 opacity-80"></i>
      <h1 class="text-9xl font-bold text-white mb-4">403</h1>
      <h2 class="text-3xl font-bold text-white mb-2">Access Denied</h2>
      <p class="text-red-100 text-lg"><%= message || 'You do not have permission to access this page.' %></p>
    </div>

    <div class="flex gap-4 justify-center">
      <a href="/" class="px-6 py-3 bg-white text-red-600 rounded-lg font-semibold hover:bg-red-50 transition-colors">
        <i class="fas fa-home mr-2"></i>
        Go Home
      </a>
      <a href="/logout" class="px-6 py-3 bg-white bg-opacity-20 text-white rounded-lg font-semibold hover:bg-opacity-30 transition-colors">
        <i class="fas fa-sign-out-alt mr-2"></i>
        Logout
      </a>
    </div>
  </div>
</body>
</html>
